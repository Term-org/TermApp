# term-api - use the Android features of the TermAPI app
#
# Usage: term-api status
#        term-api shizuku status | authorize
#        term-api shizuku exec [-t SECONDS] COMMAND...

set -u

usage() {
    cat <<'EOF'
term-api - use the Android features of the TermAPI app

Usage:
  term-api status                           Show the connection to TermAPI
  term-api shizuku status                   Show whether TermAPI may use Shizuku
  term-api shizuku authorize                Ask Shizuku to authorize TermAPI
  term-api shizuku exec [-t SECONDS] CMD... Run a command with the shell privileges of Shizuku

TermAPI must be installed and connected (Settings > Connect to TermAPI), and Shizuku
must be running. Quote the command when it contains characters the shell would use:
  term-api shizuku exec 'pm list packages | head -n 5'
EOF
}

encode() {
    printf '%s' "$1" | base64 -w0
}

case "${1:-}" in
    status)
        op="status"
        shift
        ;;
    shizuku)
        case "${2:-}" in
            status) op="shizuku-status" ;;
            authorize) op="shizuku-authorize" ;;
            exec) op="shizuku-exec" ;;
            *)
                usage >&2
                exit 2
                ;;
        esac
        shift 2
        ;;
    -h|--help|help)
        usage
        exit 0
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac

if ! command -v base64 >/dev/null 2>&1; then
    echo "term-api: base64 was not found" >&2
    exit 1
fi

cmd=""
timeout=60
limit=20
case "$op" in
    shizuku-authorize)
        limit=150
        ;;
    shizuku-exec)
        if [ "${1:-}" = "-t" ]; then
            timeout="${2:-}"
            case "$timeout" in
                ''|*[!0-9]*)
                    echo "term-api: -t needs a number of seconds" >&2
                    exit 2
                    ;;
            esac
            shift 2
        fi
        if [ $# -eq 0 ]; then
            echo "term-api: give the command to run" >&2
            exit 2
        fi
        cmd="$*"
        limit=$((timeout + 40))
        ;;
esac

token="$$-$RANDOM-$(date +%s)"
prefix="${TMPDIR:-/tmp}/term-api.$token"

printf '\033]1337;TermCmd=api;op=%s;token=%s;cmd=%s;timeout=%s\a' \
    "$(encode "$op")" "$(encode "$token")" "$(encode "$cmd")" "$(encode "$timeout")"

steps=$((limit * 2))
waited=0
while [ ! -f "$prefix.done" ] && [ "$waited" -lt "$steps" ]; do
    sleep 0.5
    waited=$((waited + 1))
done

if [ ! -f "$prefix.done" ]; then
    echo "term-api: the app did not answer in time" >&2
    rm -f "$prefix.out" "$prefix.err" "$prefix.code" "$prefix.done"
    exit 1
fi

if [ -f "$prefix.out" ]; then
    cat "$prefix.out"
fi
if [ -f "$prefix.err" ]; then
    cat "$prefix.err" >&2
fi
code="$(cat "$prefix.code" 2>/dev/null)"
rm -f "$prefix.out" "$prefix.err" "$prefix.code" "$prefix.done"
exit "${code:-1}"