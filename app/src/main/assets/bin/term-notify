# term-notify - show an Android notification
#
# Usage: term-notify [-t TITLE] [-i ID] [--ongoing] [-c CONTENT | CONTENT...]
#        term-notify --remove -i ID

set -u

usage() {
    cat <<'EOF'
term-notify - show an Android notification

Usage:
  term-notify [-t TITLE] [-i ID] [--ongoing] [-c CONTENT | CONTENT...]
  term-notify --remove -i ID

Options:
  -t, --title TITLE     Title (default: the name of the app)
  -c, --content TEXT    Text of the notification
  -i, --id ID           A name; showing the same ID again replaces the notification
      --ongoing         The notification cannot be swiped away
      --remove          Remove the notification with the given ID

Example:
  make && term-notify -t Build "Finished" || term-notify -t Build "Failed"
EOF
}

title=""
content=""
id=""
ongoing=""
remove=""

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -t|--title)
            title="${2:-}"
            shift 2
            ;;
        -c|--content)
            content="${2:-}"
            shift 2
            ;;
        -i|--id)
            id="${2:-}"
            shift 2
            ;;
        --ongoing)
            ongoing="1"
            shift
            ;;
        --remove)
            remove="1"
            shift
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "term-notify: unknown option: $1" >&2
            exit 2
            ;;
        *)
            break
            ;;
    esac
done

if [ $# -gt 0 ]; then
    content="$*"
fi

if [ -n "$remove" ]; then
    if [ -z "$id" ]; then
        echo "term-notify: --remove needs an ID (-i)" >&2
        exit 2
    fi
elif [ -z "$title" ] && [ -z "$content" ]; then
    usage >&2
    exit 2
fi

if ! command -v base64 >/dev/null 2>&1; then
    echo "term-notify: base64 was not found" >&2
    exit 1
fi

encode() {
    printf '%s' "$1" | base64 -w0
}

printf '\033]1337;TermCmd=notify;title=%s;content=%s;id=%s;ongoing=%s;remove=%s\a' \
    "$(encode "$title")" "$(encode "$content")" "$(encode "$id")" "$(encode "$ongoing")" "$(encode "$remove")"