# term-open - open a link or a file with another app
#
# Usage: term-open [-t MIME] TARGET

set -u

usage() {
    cat <<'EOF'
term-open - open a link or a file with another app

Usage: term-open [-t MIME] TARGET

TARGET is a link (http, https, mailto, tel or geo) or a file inside the app
storage or the shared storage. The app asks for confirmation before opening it.
EOF
}

mime=""
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -t|--type)
            mime="${2:-}"
            if [ -z "$mime" ]; then
                echo "term-open: -t needs a MIME type" >&2
                exit 2
            fi
            shift 2
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "term-open: unknown option: $1" >&2
            exit 2
            ;;
        *)
            break
            ;;
    esac
done

if [ $# -ne 1 ]; then
    usage >&2
    exit 2
fi
target="$1"

if ! command -v base64 >/dev/null 2>&1; then
    echo "term-open: base64 was not found" >&2
    exit 1
fi

encode() {
    printf '%s' "$1" | base64 -w0
}

case "$target" in
    http://*|https://*|mailto:*|tel:*|geo:*)
        ;;
    *://*)
        echo "term-open: unsupported link type: $target" >&2
        exit 2
        ;;
    *)
        if [ ! -e "$target" ]; then
            echo "term-open: no such file: $target" >&2
            exit 1
        fi
        target="$(readlink -f -- "$target")"
        if [ ! -f "$target" ]; then
            echo "term-open: not a regular file: $target" >&2
            exit 1
        fi
        ;;
esac

printf '\033]1337;TermCmd=open;target=%s;type=%s\a' "$(encode "$target")" "$(encode "$mime")"
echo "Asked the app to open: $target (confirm on the screen)"