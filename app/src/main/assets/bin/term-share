# term-share - share text or a file with another app
#
# Usage: term-share [-t TITLE] [-m MIME] [FILE]
#        command | term-share [-t TITLE]

set -u

usage() {
    cat <<'EOF'
term-share - share text or a file with another app

Usage:
  term-share [-t TITLE] [-m MIME] FILE
  command | term-share [-t TITLE]

With a FILE inside the app storage or the shared storage, the file is shared.
Without one, the text from the standard input is shared. The app asks for
confirmation before the share sheet opens.
EOF
}

title=""
mime=""
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -t|--title)
            title="${2:-}"
            if [ -z "$title" ]; then
                echo "term-share: -t needs a title" >&2
                exit 2
            fi
            shift 2
            ;;
        -m|--mime)
            mime="${2:-}"
            if [ -z "$mime" ]; then
                echo "term-share: -m needs a MIME type" >&2
                exit 2
            fi
            shift 2
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "term-share: unknown option: $1" >&2
            exit 2
            ;;
        *)
            break
            ;;
    esac
done

if [ $# -gt 1 ]; then
    usage >&2
    exit 2
fi

if ! command -v base64 >/dev/null 2>&1; then
    echo "term-share: base64 was not found" >&2
    exit 1
fi

encode() {
    printf '%s' "$1" | base64 -w0
}

if [ $# -eq 1 ]; then
    if [ ! -f "$1" ]; then
        echo "term-share: not a regular file: $1" >&2
        exit 1
    fi
    kind="file"
    path="$(readlink -f -- "$1")"
else
    if [ -t 0 ]; then
        echo "term-share: nothing to share; give a file or pipe text into the command" >&2
        exit 2
    fi
    tmp="$(mktemp "${TMPDIR:-/tmp}/term-share.XXXXXX")" || exit 1
    cat > "$tmp"
    if [ ! -s "$tmp" ]; then
        rm -f "$tmp"
        echo "term-share: no text was received" >&2
        exit 1
    fi
    kind="text"
    path="$(readlink -f -- "$tmp")"
fi

printf '\033]1337;TermCmd=share;kind=%s;path=%s;title=%s;type=%s\a' \
    "$(encode "$kind")" "$(encode "$path")" "$(encode "$title")" "$(encode "$mime")"
echo "Asked the app to share it (confirm on the screen)"