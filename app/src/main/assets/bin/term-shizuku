# term-shizuku - authorize rish (Shizuku) for this app
#
# Usage: term-shizuku [authorize|status]

set -u

usage() {
    cat <<'EOF'
term-shizuku - authorize rish (Shizuku) for this app

Usage:
  term-shizuku [authorize]   Ask Shizuku to authorize this app (default)
  term-shizuku status        Show the state without asking

Shizuku itself must be running. Start it once in the Shizuku app (wireless
debugging or root). After that, rish works:  rish -c id
EOF
}

action="${1:-authorize}"
case "$action" in
    authorize|status)
        ;;
    -h|--help|help)
        usage
        exit 0
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac

if ! command -v base64 >/dev/null 2>&1; then
    echo "term-shizuku: base64 was not found" >&2
    exit 1
fi

state_file="$HOME/.term/shizuku.state"
token="$$-$RANDOM-$(date +%s)"
printf '\033]1337;TermCmd=shizuku;action=%s;token=%s\a' \
    "$(printf '%s' "$action" | base64 -w0)" "$(printf '%s' "$token" | base64 -w0)"

limit=10
if [ "$action" = "authorize" ]; then
    limit=240
fi

state=""
waited=0
while [ "$waited" -lt "$limit" ]; do
    if [ "$(sed -n 2p "$state_file" 2>/dev/null)" = "$token" ]; then
        state="$(sed -n 1p "$state_file" 2>/dev/null)"
        break
    fi
    sleep 0.5
    waited=$((waited + 1))
done

case "$state" in
    READY)
        echo "Shizuku is ready and rish is authorized for this app."
        echo "Try:  rish -c id"
        exit 0
        ;;
    NOT_RUNNING)
        echo "Shizuku is not running. Open the Shizuku app and start it (wireless debugging or root), then run this command again." >&2
        ;;
    NEEDS_PERMISSION)
        echo "Shizuku is running but this app is not authorized yet. Run: term-shizuku authorize" >&2
        ;;
    DENIED)
        echo "The authorization was denied. Allow this app in the Shizuku app, under the authorized apps." >&2
        ;;
    UNSUPPORTED)
        echo "This version of Shizuku is too old. Update the Shizuku app." >&2
        ;;
    *)
        echo "term-shizuku: the app did not answer in time" >&2
        ;;
esac
exit 1