# term-wakelock - keep the CPU and Wi-Fi awake while the screen is off
#
# Usage: term-wakelock on | off

set -u

usage() {
    cat <<'EOF'
term-wakelock - keep the CPU and Wi-Fi awake while the screen is off

Usage:
  term-wakelock on     Acquire the wake lock
  term-wakelock off    Release it

The lock also shows as a button in the notification of the app. It uses battery,
and it is released automatically when the last session closes.
EOF
}

case "${1:-}" in
    on|acquire)
        state=1
        ;;
    off|release)
        state=0
        ;;
    -h|--help|help)
        usage
        exit 0
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac

if ! command -v base64 >/dev/null 2>&1; then
    echo "term-wakelock: base64 was not found" >&2
    exit 1
fi

printf '\033]1337;TermCmd=wakelock;state=%s\a' "$(printf '%s' "$state" | base64 -w0)"
if [ "$state" = "1" ]; then
    echo "Wake lock requested. It is shown in the notification."
else
    echo "Wake lock released."
fi