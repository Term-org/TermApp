# terminal-vnc - start a VNC server and open it in the built-in viewer
#
# Usage:
#   terminal-vnc [start] [-d NUMBER] [-g WIDTHxHEIGHT]
#   terminal-vnc open   [-H HOST] [-p PORT]
#   terminal-vnc stop   [-d NUMBER]
#   terminal-vnc status [-d NUMBER]

set -u

display_number=1
geometry="1280x720"
host="127.0.0.1"
port=""
command_name="start"

emit() {
    printf '\033]1337;TermVnc=%s\a' "$1"
}

usage() {
    cat <<'EOF'
terminal-vnc - VNC server launcher for the built-in viewer

Usage:
  terminal-vnc [start] [-d NUMBER] [-g WIDTHxHEIGHT]
  terminal-vnc open   [-H HOST] [-p PORT]
  terminal-vnc stop   [-d NUMBER]
  terminal-vnc status [-d NUMBER]

Options:
  -d, --display NUMBER     VNC display number (default 1, port 5900 + NUMBER)
  -g, --geometry SIZE      Desktop size for a new server (default 1280x720)
  -H, --host HOST          Host used by "open" (default 127.0.0.1)
  -p, --port PORT          Port used by "open" (default 5900 + display)
  -h, --help               Show this help
EOF
}

if [ $# -gt 0 ]; then
    case "$1" in
        start|open|stop|status)
            command_name="$1"
            shift
            ;;
        -h|--help|help)
            usage
            exit 0
            ;;
    esac
fi

while [ $# -gt 0 ]; do
    case "$1" in
        -d|--display)
            display_number="${2:?terminal-vnc: missing display number}"
            shift 2
            ;;
        -g|--geometry)
            geometry="${2:?terminal-vnc: missing geometry}"
            shift 2
            ;;
        -p|--port)
            port="${2:?terminal-vnc: missing port}"
            shift 2
            ;;
        -H|--host)
            host="${2:?terminal-vnc: missing host}"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "terminal-vnc: unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

case "$display_number" in
    ''|*[!0-9]*)
        echo "terminal-vnc: display must be a number" >&2
        exit 2
        ;;
esac

case "$geometry" in
    *[!0-9x]*|x*|*x|*x*x*|"")
        echo "terminal-vnc: geometry must look like 1280x720" >&2
        exit 2
        ;;
    *x*) ;;
    *)
        echo "terminal-vnc: geometry must look like 1280x720" >&2
        exit 2
        ;;
esac

if [ -z "$port" ]; then
    port=$((5900 + display_number))
fi

port_open() {
    (exec 3<>"/dev/tcp/$1/$2") 2>/dev/null
}

do_start() {
    if port_open "$host" "$port"; then
        echo "VNC server is already running on $host:$port"
    else
        if ! command -v vncserver >/dev/null 2>&1; then
            echo "terminal-vnc: vncserver was not found. Install a VNC server (TigerVNC) first." >&2
            exit 1
        fi
        if [ ! -f "$HOME/.vnc/passwd" ]; then
            echo "No VNC password is set yet. Create one now (maximum 8 characters are used):"
            vncpasswd || exit 1
        fi
        vncserver ":$display_number" -geometry "$geometry" -localhost yes -SecurityTypes VncAuth || exit 1
        waited=0
        until port_open "$host" "$port"; do
            waited=$((waited + 1))
            if [ "$waited" -ge 20 ]; then
                echo "terminal-vnc: server did not start listening on $host:$port" >&2
                exit 1
            fi
            sleep 0.5
        done
    fi
    emit "open;host=$host;port=$port"
    echo "Opened the built-in viewer for $host:$port"
}

case "$command_name" in
    start)
        do_start
        ;;
    open)
        emit "open;host=$host;port=$port"
        ;;
    stop)
        if command -v vncserver >/dev/null 2>&1; then
            vncserver -kill ":$display_number"
        else
            echo "terminal-vnc: vncserver was not found" >&2
        fi
        emit "close"
        ;;
    status)
        if port_open "$host" "$port"; then
            echo "VNC server is running on $host:$port"
            exit 0
        fi
        echo "VNC server is not running on $host:$port"
        exit 1
        ;;
esac